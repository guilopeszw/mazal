{
  "name": "mazal",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests && pnpm --filter @mazal/mcp typecheck",
    "typecheck": "tsc --build && pnpm --filter @mazal/mcp typecheck",
    "derive": "node packages/data/derive.ts",
    "sim:eyeball": "node packages/sim/eyeball.ts",
    "sim:fixtures": "node packages/sim/write-fixtures.ts",
    "sim:backtest": "node packages/sim/run-backtest.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
